# ============================================================
# Paradox Ticket Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
#   cp .env.example .env
# NEVER commit .env to version control.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or local)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── Authentication ───────────────────────────────────────────
# Secret used to sign JWT tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me_to_a_random_64_char_hex_string

# ── Email (EmailJS) ─────────────────────────────────────────
# Optional — if omitted, emails are logged to the console.
# Sign up at https://www.emailjs.com and create a service + template.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# ── Gmail SMTP (alternative email transport) ─────────────────
# Optional — only needed if you use Nodemailer with Gmail.
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password