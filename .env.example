# Database Configuration
# Create a free Postgres database at Neon.tech or Supabase
DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require

# Authentication
# Replace with a strong random string (e.g. openssl rand -base64 32)
SESSION_SECRET=your_super_secret_jwt_key_here

# Email Provider API Key (e.g., Resend, SendGrid)
# Get your API key from resend.com
EMAIL_API_KEY=re_your_api_key_here