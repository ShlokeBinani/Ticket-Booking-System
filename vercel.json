{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/artifacts/paradox-ticket/dist/index.html"
    }
  ]
}
